from pathlib import Path

import numpy as np
import xarray as xr


PROCESSED_DIR = Path("../datasets/VNP46/processed")


def open_processed_cube(product):
    store_path = (
        PROCESSED_DIR
        / f"Haiyan_{product}.zarr"
    )

    consolidated = (
        store_path / ".zmetadata"
    ).exists()

    dataset = xr.open_zarr(
        store_path,
        consolidated=consolidated,
        mask_and_scale=False,
    )

    completed_indexes = np.flatnonzero(
        dataset["processed"].values == 1
    )

    return dataset.isel(
        date=completed_indexes
    )


vnp46a1 = open_processed_cube("VNP46A1")
vnp46a2 = open_processed_cube("VNP46A2")

print(vnp46a1)
print(vnp46a2)

print(
    "VNP46A1 available dates:",
    vnp46a1.date.values[0],
    "to",
    vnp46a1.date.values[-1],
)

print(
    "VNP46A2 available dates:",
    vnp46a2.date.values[0],
    "to",
    vnp46a2.date.values[-1],
)